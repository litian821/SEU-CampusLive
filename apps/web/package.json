{
  "name": "campus-live-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": { "vue": "3.5.42", "vue-router": "4.6.4", "hls.js": "1.7.3" },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "vue-tsc": "3.3.11",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "jsdom": "30.0.1",
    "eslint": "10.10.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.70.0",
    "eslint-plugin-vue": "10.11.0"
  }
}
