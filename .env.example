# Copy to .env for local overrides. Do not commit .env.
APP_ENV=development
APP_NAME=Campus Sports Platform
WEB_PORT=8080
RTMP_PORT=1935
SRS_API_PORT=1985
# RTMP application is fixed to live; channel names: letters, digits, _ and -.
LIVE_TITLE=院系杯 · 网络空间安全学院 vs 电子科学与工程学院
LIVE_SPORT=篮球
LIVE_VENUE=东南大学
LIVE_STREAM_KEY=demo
# Optional: one JSON line groups unique stream ids into matches and camera angles.
# LIVE_MATCHES_JSON=[{"id":"faculty-cup","title":"院系杯决赛","sport":"篮球","venue":"九龙湖体育馆","angles":[{"stream_id":"faculty-main","name":"主机位"},{"stream_id":"faculty-hoop","name":"篮下机位"},{"stream_id":"faculty-wide","name":"全景机位"}]}]
VOD_DIR=/data/vod
